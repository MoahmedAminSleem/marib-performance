// Marib Performance Studio — LOCAL DEV schema (SQLite in ./db/)
// Identical models to schema.prisma but provider=sqlite so the sandbox
// dev server runs without a Postgres install. Production (Vercel+Neon)
// generates from schema.prisma (postgres). Keep the two files in sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id @default(autoincrement())
  username    String    @unique
  role        String    @default("user")
  canUpload   Boolean   @default(false)
  active      Boolean   @default(true)
  pwHash      String
  failedCount Int       @default(0)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model MonthData {
  id           Int      @id @default(autoincrement())
  monthKey     String   @unique
  label        String   @default("")
  packJson     String
  fileNames    String   @default("[]")
  uploadedById Int?
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
